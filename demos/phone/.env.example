# copy to .env in the project root (or demos/phone/.env) and fill in; .env is git-ignored, never commit it
DEEPGRAM_API_KEY=        # console.deepgram.com: speech-to-text and the Aura voice
ANTHROPIC_API_KEY=       # console.anthropic.com: the receptionist, always Claude Haiku 5.5 (~$0.005 a call)
TWILIO_ACCOUNT_SID=      # console.twilio.com: lets start.py point the number at the tunnel...
TWILIO_AUTH_TOKEN=       # ...and turns on Twilio request-signature checks
# TWILIO_NUMBER=+1...    # only if the account has several numbers

# optional
# DEMO_MODE=layer        # default mode (baseline | layer); switch live: curl http://localhost:8765/mode/baseline
# RECORD=1               # save each call as stereo wav in demos/phone/recordings/ (the greeting then says so)
# TRANSCRIPTS=1          # log what the caller and agent said (personal data; off by default)
# CLINIC_DB=data/clinic.sqlite
# CLINIC_COUNTRY_CODE=44 # for local numbers ("07700 ..." -> +447700...)
# MAX_CALLS=2
# GROQ_API_KEY=          # optional free fallback (LLM=groq); truncated replies on live calls
